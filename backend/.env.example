# --- Core ---
DATABASE_URL=postgresql://flowboard:flowboard@localhost:5432/flowboard
JWT_ACCESS_SECRET=replace-with-a-long-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-refresh-secret
# Comma-separated allowlist of browser origins allowed to call the API with
# credentials. Include both localhost and 127.0.0.1 for local dev so opening the
# app on either host works. In production set this to your deployed frontend URL.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# In production set NODE_ENV=production and COOKIE_SECURE=true (required for the
# cross-site httpOnly refresh cookie to be sent over HTTPS).
NODE_ENV=development
COOKIE_SECURE=false
PORT=4000

# --- Ask AI chatbot (Google Gemini) ---
# Server-side only. Used by POST /ai/chat (model: gemini-2.5-flash). If unset,
# the Ask AI endpoint returns a disabled response instead of erroring.
GOOGLE_API_KEY=

# --- Help & Support (Vapi voice assistant) ---
# VAPI_PUBLIC_KEY is exposed to the browser via GET /support/config so the Vapi
# Web SDK can start a call. VAPI_PRIVATE_KEY is NEVER returned to the client and
# is reserved for server-side Vapi REST calls only. VAPI_ASSISTANT_ID is optional
# (falls back to an inline assistant config when absent). If VAPI_PUBLIC_KEY is
# unset, /support/config returns { enabled: false } and the widget hides itself.
VAPI_PUBLIC_KEY=
VAPI_PRIVATE_KEY=
VAPI_ASSISTANT_ID=
