# Public base URL of the FlowBoard API. Baked into the client bundle at BUILD time
# (Next.js inlines NEXT_PUBLIC_* at build), so it must be set before `npm run build`.
# Local dev: http://localhost:4000
# Render: the API service's public URL, e.g. https://flowboard-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000